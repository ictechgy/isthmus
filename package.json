{
  "name": "isthmus-cli",
  "version": "0.9.0",
  "description": "Join bridge facts across cross-platform application boundaries.",
  "keywords": [
    "flutter",
    "platform-channel",
    "bridge",
    "static-analysis",
    "dead-code"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ictechgy/isthmus.git"
  },
  "bugs": {
    "url": "https://github.com/ictechgy/isthmus/issues"
  },
  "homepage": "https://github.com/ictechgy/isthmus#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "isthmus": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "Skills",
    "scripts/capture-preflight.mjs",
    "scripts/run-child.mjs",
    "scripts/build-preflight-toolchain.mjs",
    "docs/TOOLCHAIN.md",
    "docs/COMPATIBILITY.md",
    "docs/PREFLIGHT.md",
    "docs/RUNTIME.md",
    "docs/IMPACT.md",
    "docs/BRIDGE-MESSAGES.md",
    "docs/BRIDGE-EVENTS.md",
    "docs/BRIDGE-RN-EVENTS.md",
    "docs/MCP.md",
    "docs/GRAPH-EXCHANGE.md",
    "compatibility.json",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:phase0:join": "node --test experiments/phase-0/join/join.test.mjs",
    "verify:build": "node scripts/verify-build-contract.mjs",
    "verify:cli": "npm run verify:build && node scripts/verify-cli-contract.mjs",
    "verify:package": "npm run verify:build && node scripts/verify-package-contract.mjs",
    "verify": "npm run typecheck && node scripts/verify-compatibility.mjs && npm test && npm run test:phase0:join && npm run verify:build && node --test scripts/capture-preflight.test.mjs scripts/build-preflight-toolchain.test.mjs scripts/stop-detached-process.test.mjs scripts/runtime-harness-failures.test.mjs scripts/verify-installed-compatibility.test.mjs && node scripts/verify-cli-contract.mjs && node scripts/verify-package-contract.mjs",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3"
  }
}
