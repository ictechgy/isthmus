{
  "name": "isthmus",
  "version": "0.0.0",
  "description": "Join bridge facts across cross-platform application boundaries.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "isthmus": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:cli": "npm run build && node scripts/verify-cli-contract.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:cli",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3"
  }
}
