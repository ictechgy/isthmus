  "cases": [
    {
      "id": "bp-file-swift-plugin",
      "project": "battery",
      "selection": { "swift": { "files": ["macos/battery_plus/Sources/battery_plus/BatteryPlusMacosPlugin.swift"], "symbols": [] } },
      "expectedMethods": [
        "dev.fluttercommunity.plus/battery/getBatteryLevel",
        "dev.fluttercommunity.plus/battery/isInBatterySaveMode",
        "dev.fluttercommunity.plus/battery/getBatteryState"
      ],
      "groundTruth": "파일이 채널 등록과 3개 핸들러를 모두 담는다. 소스 확인: register + handle switch 3 cases."
    },
    {
      "id": "bp-file-dart-channel",
      "project": "battery",
      "selection": { "dart": { "files": ["lib/method_channel_battery_plus.dart"], "symbols": [] } },
      "expectedMethods": [
        "dev.fluttercommunity.plus/battery/getBatteryLevel",
        "dev.fluttercommunity.plus/battery/isInBatterySaveMode",
        "dev.fluttercommunity.plus/battery/getBatteryState"
      ],
      "groundTruth": "MethodChannel 생성과 3개 invokeMethod가 한 파일에 있다. EventChannel 생성도 같은 파일이다."
    },
    {
      "id": "bp-symbol-dart-batterylevel",
      "project": "battery",
      "selection": { "dart": { "files": [], "symbols": ["package:battery_plus_platform_interface/method_channel_battery_plus.dart::MethodChannelBattery.batteryLevel"] } },
      "expectedMethods": ["dev.fluttercommunity.plus/battery/getBatteryLevel"],
      "groundTruth": "batteryLevel()만 invokeMethod('getBatteryLevel')를 호출한다."
    },
    {
      "id": "bp-file-event-handler",
      "project": "battery",
      "selection": { "swift": { "files": ["macos/battery_plus/Sources/battery_plus/BatteryPlusChargingHandler.swift"], "symbols": [] } },
      "expectedMethods": [],
      "expectedChannels": ["dev.fluttercommunity.plus/charging"],
      "expectGap": true,
      "groundTruth": "EventChannel 스트림 핸들러 파일. isthmus는 Event 채널을 미지원하므로 method 경계가 없어야 하며 채널 생성 경계 또는 공백 한계로 드러나야 한다."
    },
    {
      "id": "bp-diff-622-623",
      "project": "battery-base",
      "applyArchive": { "archive": "battery_plus@6.2.3", "paths": ["macos", "ios", "android"] },
      "expectedMethods": [
        "dev.fluttercommunity.plus/battery/getBatteryLevel",
        "dev.fluttercommunity.plus/battery/isInBatterySaveMode",
        "dev.fluttercommunity.plus/battery/getBatteryState"
      ],
      "expectKotlinGap": true,
      "groundTruth": "실제 diff: ios/FPPBatteryPlusPlugin.m에 setBatteryMonitoringEnabled:NO 1줄 + android .kt 변경. ObjC 파일은 등록+3핸들러를 담는다. Kotlin은 미구성이라 unconfigured-platform-changes 한계가 떠야 한다."
    },
    {
      "id": "sp-file-plugin",
      "project": "shared_prefs",
      "selection": { "swift": { "files": ["darwin/shared_preferences_foundation/Sources/shared_preferences_foundation/SharedPreferencesPlugin.swift"], "symbols": [] } },
      "expectedPrefixes": "ALL",
      "groundTruth": "두 Api 구현 클래스가 이 파일에 있고 Setup이 참조한다. 11개 채널 전부 관련."
    },
    {
      "id": "sp-file-generated",
      "project": "shared_prefs",
      "selection": { "swift": { "files": ["darwin/shared_preferences_foundation/Sources/shared_preferences_foundation/messages.g.swift"], "symbols": [] } },
      "expectedPrefixes": "ALL",
      "groundTruth": "Pigeon 생성 배선 파일 — 채널 생성·핸들러 등록·codec이 모두 여기 있다."
    },
    {
      "id": "sp-symbol-legacy-remove",
      "project": "shared_prefs",
      "selection": { "swift": { "files": [], "symbols": ["s:29shared_preferences_foundation29LegacySharedPreferencesPluginC6remove3keyySS_tF"] } },
      "expectedPrefixes": ["dev.flutter.pigeon.shared_preferences_foundation.LegacyUserDefaultsApi.remove"],
      "groundTruth": "LegacySharedPreferencesPlugin.remove(key:) 구현만 선택 → dispatchTargets 근거로 해당 채널만 경계가 돼야 한다."
    },
    {
      "id": "sp-diff-253-254",
      "project": "shared_prefs-base",
      "applyArchive": { "archive": "shared_preferences_foundation@2.5.4", "paths": ["lib", "darwin", "pubspec.yaml", "LICENSE"] },
      "expectedPrefixes": "ALL",
      "groundTruth": "실제 diff: messages.g.swift의 codec 클래스명 변경(messagesPigeonCodec→MessagesPigeonCodec 등). 배선 파일 변경이므로 전 채널."
    },
    {
      "id": "ul-file-plugin",
      "project": "url_launcher",
      "selection": { "swift": { "files": ["macos/url_launcher_macos/Sources/url_launcher_macos/UrlLauncherPlugin.swift"], "symbols": [] } },
      "expectedPrefixes": "ALL",
      "groundTruth": "UrlLauncherPlugin이 UrlLauncherApi 구현 + register. 2개 채널 전부."
    },
    {
      "id": "ul-symbol-setup",
      "project": "url_launcher",
      "selection": { "swift": { "files": [], "symbols": ["s:18url_launcher_macos19UrlLauncherApiSetupC5setUp15binaryMessenger3api20messageChannelSuffixy12FlutterMacOS0p6BinaryK0_p_AA0deF0_pSgSStFZ"] } },
      "expectedPrefixes": "ALL",
      "groundTruth": "등록 함수 자체 변경 → 클로저 밖 공유 의존 변경과 동일하게 전체 관련 배선이 포함돼야 한다."
    },
    {
      "id": "ul-diff-321-322",
      "project": "url_launcher-base",
      "applyArchive": { "archive": "url_launcher_macos@3.2.2", "paths": ["lib", "macos", "pubspec.yaml", "LICENSE"] },
      "expectedPrefixes": "ALL",
      "groundTruth": "실제 diff: Pigeon 재생성(v10→v22)으로 messages.g.swift+messages.g.dart 변경 — UrlLauncherBoolResult wire format 변경. 양쪽 배선 파일."
    }
  ]
}
